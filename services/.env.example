# Copy to services/.env and fill in. docker compose reads this file; never commit the real one.

# Redis (tickers, server)
REDIS_PASSWORD=

# Market Wizard bot (Discord Developer Portal → application → Bot / General Information)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Tickers uptime heartbeat (BetterStack heartbeat URL); optional, tickers warn when unset
UPTIME_HEARTBEAT_URL=

# Cloudflare tunnel token for the webhook server
CLOUDFLARE_TUNNEL_TOKEN=

# Compose profile; `prod` starts the Cloudflare tunnel (deploy runs `docker compose --profile prod`)
ENVIRONMENT=prod

# Shared secret TradingView alerts must send to the webhook server; optional
WEBHOOK_SECRET=
