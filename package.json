{
  "name": "discord-market-bots",
  "private": true,
  "scripts": {
    "build": "npm run build:tickers && npm run build:market-wiz",
    "build:market-wiz": "npm --prefix services/market-wiz run build",
    "build:public-site": "npm --prefix public-site run build",
    "build:tickers": "npm --prefix services/tickers run build",
    "lint": "eslint services/tickers/src services/market-wiz/src --ext .ts --max-warnings 0",
    "setup": "npm ci && npm ci --prefix services/tickers && npm ci --prefix services/market-wiz && npm ci --prefix public-site",
    "test": "npm run test:repo && npm run test:tickers && npm run test:market-wiz",
    "test:market-wiz": "npm --prefix services/market-wiz test",
    "test:repo": "node --test test/*.test.cjs",
    "test:tickers": "npm --prefix services/tickers test",
    "typecheck": "npm run typecheck:tickers && npm run typecheck:market-wiz",
    "typecheck:market-wiz": "npm --prefix services/market-wiz run typecheck",
    "typecheck:tickers": "npm --prefix services/tickers run typecheck"
  },
  "engines": {
    "node": "24.22.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-sort-exports": "0.9.1",
    "typescript": "5.9.3"
  }
}
